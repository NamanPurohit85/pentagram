{
  "name": "mern-project",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "dev:backend": "bun run --filter @penta/backend dev",
    "dev:frontend": "bun run --filter frontend dev",
    "dev": "bun run dev:backend",
    "build:frontend": "bun run --filter frontend build",
    "lint:frontend": "bun run --filter frontend lint",
    "preview:frontend": "bun run --filter frontend preview"
  }
}
